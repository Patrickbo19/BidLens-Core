{
  "name": "@earn/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Non-web AI escalation bus: when an agent is blocked, package the missing work into a safe Gibwork task and pull the result back into the parent workflow.",
  "type": "module",
  "bin": { "earn-relay": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "demo": "node dist/cli.js demo"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@gibwork/sdk": "^0.2.0",
    "commander": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
